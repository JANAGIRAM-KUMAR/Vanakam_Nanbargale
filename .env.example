# Copy to .env and adjust values. NEVER commit the real .env file.

# Public site URL used for canonical/OG metadata at build time.
VITE_SITE_URL=https://janagiram.dpdns.org

# Host ports published by docker compose
HTTP_PORT=80
HTTPS_PORT=443

# --- EmailJS (optional) -----------------------------------------------
# Enables direct "Send Message" delivery from the contact form to
# janagi2368@gmail.com. These are PUBLIC identifiers (EmailJS public keys
# are designed to ship in browser bundles) — not secrets.
# Leave empty to fall back to the mailto: handler.
# Get them: https://dashboard.emailjs.com → Account / Email Services / Templates
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
